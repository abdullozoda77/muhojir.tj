SECRET_KEY=your-secret-key-at-least-32-characters-long
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL. Leave DB_NAME empty to use the local db.sqlite3 file.
DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# SMTP for login codes. Leave EMAIL_HOST empty to print letters in the Django console instead. Gmail: turn on
# 2-step verification, create an "App password" at https://myaccount.google.com/apppasswords and put it
# (16 letters, no spaces) in EMAIL_HOST_PASSWORD.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Telegram reminders (free): in Telegram open @BotFather, send /newbot, and put the token and the bot's name
# (without @) here. Then run "python manage.py telegram_bot" next to the server so it hears /start.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
