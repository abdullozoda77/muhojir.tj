SECRET_KEY=your-secret-key-at-least-32-characters-long
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL. Leave DB_NAME empty to use the local db.sqlite3 file.
DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# "console" prints login codes in the Django log instead of sending SMS.
SMS_BACKEND=console
