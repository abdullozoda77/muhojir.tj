# Muhojir daily jobs (started by muhojir-daily.timer): real vacancies from «Работа России» (and alerts about
# new ones), then the document reminders. New notifications reach open browser tabs through Redis.
[Unit]
Description=Muhojir — daily vacancy import and document reminders
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=oneshot
User=romin
Group=romin
WorkingDirectory=/home/romin/muhojir
ExecStart=/home/romin/muhojir/.venv/bin/python manage.py import_jobs
ExecStart=/home/romin/muhojir/.venv/bin/python manage.py send_reminders
